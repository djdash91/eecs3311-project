# Copy this file to ".env" (same folder) and paste your real key.
# .env is in .gitignore, so it stays on your machine.
# VS Code's Run and Debug configurations and Java test runner read this file.
ANTHROPIC_API_KEY=paste-your-key-here

# Set to true only when you want to run the live Claude connection test.
ACCESSFIX_LIVE_TESTS=false
